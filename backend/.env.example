# Copy to .env and fill in real values. NEVER commit .env.

ENVIRONMENT=development
LOG_LEVEL=INFO

# MongoDB Atlas connection string (Atlas -> Database -> Connect -> Drivers).
# Replace <username>, <password> and the cluster host. URL-encode special characters in the password.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/?retryWrites=true&w=majority&appName=PhysioBand
MONGODB_DB_NAME=physioband_ai
MONGODB_TIMEOUT_MS=8000

# Generate with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

CORS_ORIGINS=*

# Paths are relative to the backend folder
ML_SRC_PATH=../ml/src
ML_MODEL_PATH=../ml/saved_models/biceps_curl_quality.pkl

MAX_SAMPLES_PER_BATCH=500
MAX_SAMPLES_PER_SESSION=90000
