# Copy to .env. The backend URL must be reachable from the phone.
# Backend running on your Windows PC (same Wi-Fi as the phone): use the PC's IPv4 address (ipconfig).
EXPO_PUBLIC_API_URL=http://192.168.1.20:8000/api/v1
# Android emulator talking to the PC: http://10.0.2.2:8000/api/v1
# Deployed backend (recommended, HTTPS): https://your-backend.example.com/api/v1
